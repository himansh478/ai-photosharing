# Copy to .env for local development. In production set these as secrets on the host.

# --- Required ---
# Supabase PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[db]
SUPABASE_DATABASE_URL=

# Private Hugging Face dataset that stores the photos
HF_TOKEN=
HF_DATASET_ID=

# Signs the photo links. Any long random string; keep it stable across restarts.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=

# --- Recommended ---
# Enables the /api/admin endpoints (issue upload keys, purge old events).
# Without it those endpoints do not exist.
ADMIN_SECRET=

# --- Optional ---
# Days after which an event may be purged, and whether to purge automatically every day.
RETENTION_DAYS=90
RETENTION_AUTO_PURGE=false

# Reverse proxies in front of the app (1 on Hugging Face Spaces; 0 when run directly).
TRUSTED_PROXY_HOPS=1

# Error reporting
SENTRY_DSN=

# 'local' stores photos on disk instead of Hugging Face (development only).
STORAGE_BACKEND=hf
